def exec_claude(prompt, schema, timeout, model=None, cwd=None, tag=None, tools=None):
    """claude -p 헤드리스. 도구 제한 + 스키마 강제. 반환 (payload|None, meta)."""
    exe = claude_bin()
    if not exe:
        return None, {"executor": "claude", "error": "claude 실행 파일을 찾지 못함: GE_CLAUDE 를 설정", "duration_s": 0.0}
    cmd = [exe, "--print", "--output-format", "json", "--json-schema", json.dumps(schema),
           "--disallowedTools", WORKER_DISALLOWED, "--permission-mode", "dontAsk",
           "--no-session-persistence"]
    if exe.lower().endswith(".py"):           # wrapper script / test fake, same rule as grok_cmd
        cmd = [sys.executable] + cmd
    if model:
        cmd += ["--model", model]
    env = os.environ.copy()
    env.pop("ANTHROPIC_API_KEY", None)
    t0 = time.time()
    try:
        r = subprocess.run(cmd, input=prompt, capture_output=True, text=True, encoding="utf-8", timeout=timeout,
                           cwd=cwd or PROJ, env=env)
    except subprocess.TimeoutExpired:
        return None, {"executor": "claude", "error": "timeout", "duration_s": round(time.time() - t0, 1)}
    except OSError as e:
        return None, {"executor": "claude", "error": f"claude 실행 실패 ({exe}): {e}"[-400:], "duration_s": round(time.time() - t0, 1)}
    meta = {"executor": "claude", "duration_s": round(time.time() - t0, 1), "exit": r.returncode}
    if r.returncode != 0:
        meta["error"] = (r.stderr or r.stdout)[-400:]
        return None, meta
    try:
        raw = json.loads(r.stdout)
    except Exception:
        meta["error"] = "stdout 이 JSON 이 아님"
        return None, meta
    usage = raw.get("usage") or {}
    meta.update({"model": raw.get("model") or next(iter(raw.get("modelUsage") or {}), None),
                 "input_tokens": usage.get("input_tokens"), "output_tokens": usage.get("output_tokens"),
                 "cache_read": usage.get("cache_read_input_tokens"), "cache_write": usage.get("cache_creation_input_tokens"),
                 "cost_usd": raw.get("total_cost_usd"), "session_sha": sha256_text(str(raw.get("session_id", "")))[:12]})
    payload = raw.get("structured_output", raw.get("result"))
    if isinstance(payload, str):
        try:
            payload = json.loads(payload)
        except Exception:
            meta["error"] = "result 가 JSON 이 아님"
            return None, meta
    return payload, meta


def exec_stub(prompt, schema, timeout, model=None, cwd=None, tag=None, tools=None):
    """모델 없이 스키마에 맞는 최소 산출물을 만든다. 배선·원장·집계 시험용."""
    def fill(s):
        t = s.get("type")
        if t == "object":
            return {k: fill(v) for k, v in s.get("properties", {}).items() if k in s.get("required", s.get("properties", {}))}
        if t == "array":
            return [fill(s.get("items", {})) for _ in range(max(1, s.get("minItems", 1)))]
        if t == "string":
            if "enum" in s:
                return s["enum"][0]
            return ("stub-" * 40)[:max(s.get("minLength", 4), 4)]
        if t in ("number", "integer"):
            return 0
        if t == "boolean":
            return True
        return None
    # STUB_FAIL_ONCE=<node> 로 재작업 경로를 시험한다
    if os.environ.get("STUB_FAIL_ONCE") and os.environ["STUB_FAIL_ONCE"] in prompt and not os.environ.get("_STUB_FAILED"):
        os.environ["_STUB_FAILED"] = "1"
        return {"bogus": 1}, {"executor": "stub", "duration_s": 0.0, "model": "stub"}
    return fill(schema), {"executor": "stub", "duration_s": 0.0, "model": "stub", "input_tokens": 0, "output_tokens": 0, "cost_usd": 0.0}


def parse_grok_output(raw):
    """Grok --output-format json 봉투 -> (payload, meta 필드). 본문은 넣지 않는다."""
    payload = raw.get("structuredOutput", raw.get("structured_output"))
    if payload is None:
        text = raw.get("text") or raw.get("result")
        if isinstance(text, str):
            try:
                payload = json.loads(text)
            except Exception:
                payload = None
        elif isinstance(text, dict):
            payload = text
    mu = raw.get("modelUsage") or raw.get("model_usage") or {}
    model = next(iter(mu), None) if isinstance(mu, dict) and mu else raw.get("model")
    usage = raw.get("usage") or {}
    sid = raw.get("sessionId") or raw.get("session_id") or ""
    meta = {
        "model": model,
        "input_tokens": usage.get("input_tokens"),
        "output_tokens": usage.get("output_tokens"),
        "cache_read": usage.get("cache_read_input_tokens") or usage.get("cacheReadInputTokens"),
        "cost_usd": raw.get("total_cost_usd"),
        "session_sha": sha256_text(str(sid))[:12] if sid else None,
    }
    return payload, meta


def _finish_grok_stdout(stdout, stderr, meta):
    if meta.get("exit") not in (0, None) and not (stdout or "").strip():
        meta["error"] = (stderr or "")[-400:]
        return None, meta
    try:
        raw = json.loads(stdout)
    except Exception:
        meta["error"] = "stdout 이 JSON 이 아님"
        if stderr:
            meta["stderr"] = stderr[-200:]
        return None, meta
    payload, extra = parse_grok_output(raw)
    meta.update({k: v for k, v in extra.items() if v is not None})
    if payload is None:
        meta["error"] = "structuredOutput 없음"
        return None, meta
    return payload, meta


def _write_grok_call_dir(prompt, schema, call_dir=None):
    """호출 디렉터리(prompt.txt/schema.json/stdout.json). 워커 cwd 와는 별개다 — 워커를 레포로 보내도 레포에 파일을 남기지 않는다."""
    here = call_dir or tempfile.mkdtemp(prefix="ge-grok-")
    os.makedirs(here, exist_ok=True)
    with open(os.path.join(here, "prompt.txt"), "w", encoding="utf-8") as f:
        f.write(prompt)
    with open(os.path.join(here, "schema.json"), "w", encoding="utf-8") as f:
        json.dump(schema, f, ensure_ascii=False)
    return here


def run_headless(argv, here, timeout, env=None, stdin_file=None):
    """Run a worker CLI as a quiet subprocess. Returns (exit_code|None, stdout, stderr)."""
    env_all = {**os.environ, **(env or {})}
    stdin_text = _rt(stdin_file, encoding="utf-8") if stdin_file else None
    try:
        r = subprocess.run(argv, input=stdin_text, capture_output=True, text=True, encoding="utf-8", timeout=timeout,
                           cwd=env_all.get("GE_CWD") or None, env=env_all)
    except subprocess.TimeoutExpired:
        return None, "", "timeout"
    except OSError as e:
        return None, "", f"실행 실패: {e}"
    return r.returncode, r.stdout or "", r.stderr or ""


def _json_lines(text):
    out = []
    for l in text.splitlines():
        l = l.strip()
        if l.startswith("{"):
            try:
                out.append(json.loads(l))
            except Exception:
                pass
    return out


def _grok_argv(here, model, cwd=None, read=False):
    cmd = grok_cmd()
    if not cmd:
        return None
    with open(os.path.join(here, "schema.json"), encoding="utf-8") as f:
        schema_text = f.read()
    cmd += [
        "--prompt-file", os.path.join(here, "prompt.txt"),
        "--json-schema", schema_text,
        "--cwd", cwd or here,
        "--system-prompt-override", GROK_OVERRIDE_READ if read else GROK_OVERRIDE,
        "--disallowed-tools", os.environ.get("GE_GROK_DISALLOWED") or (GROK_DISALLOWED_READ_OK if read else GROK_DISALLOWED),
        "--permission-mode", "dontAsk",
        "--max-turns", "24" if read else "4",
        "--verbatim",
        "--no-auto-update",
    ]
    if os.environ.get("GE_GROK_EXTRA"):       # JSON list of extra flags, e.g. ["--effort","medium"]
        cmd += json.loads(os.environ["GE_GROK_EXTRA"])
    if model:
        cmd += ["--model", model]
    return cmd


def exec_grok(prompt, schema, timeout, model=None, cwd=None, tag=None, tools=None):
    """grok headless. tools="read" lets the worker read files first; default answers in one shot without tools."""
    if not grok_cmd():
        return None, {"executor": "grok", "error": "grok 실행 파일을 찾지 못함: GE_GROK 를 설정", "duration_s": 0.0}
    here = _write_grok_call_dir(prompt, schema)
    cmd = _grok_argv(here, model, cwd, read=tools == "read")
    env = {"GE_WORKER": "1", "GE_CWD": cwd or here}
    t0 = time.time()
    code, out, err = run_headless(cmd, here, timeout, env=env)
    with open(os.path.join(here, "stdout.json"), "w", encoding="utf-8", errors="replace") as f:
        f.write(out)
    meta = {"executor": "grok", "duration_s": round(time.time() - t0, 1), "exit": code, "call_dir": here}
    if code is None:
        meta["error"] = err or "timeout"
        return None, meta
    return _finish_grok_stdout(out, err, meta)


def _strip_fences(s):
    s = s.strip()
    if s.startswith("```"):
        s = s.split("\n", 1)[1] if "\n" in s else ""
        if s.rstrip().endswith("```"):
            s = s.rstrip()[:-3]
    return s.strip()


def _trailing_json(text):
    """Cursor 는 result 에 서술문과 최종 JSON 을 이어 붙인다 ("...하겠습니다.{...}"). 마지막 최상위 객체를 꺼낸다.
    앞에서부터 raw_decode 로 후보를 훑는다 — 뒤에서 중괄호를 세는 방식은 **문자열 안의 중괄호**에 걸려 깨졌다
    (예: 패치 본문의 `{$var}` 같은 중괄호 때문에 완전한 JSON 을 'JSON 이 아님' 으로 버렸다)."""
    s = _strip_fences(text)
    try:
        return json.loads(s)
    except Exception:
        pass
    dec = json.JSONDecoder()
    best, i = None, s.find("{")
    while i != -1:
        try:
            obj, end = dec.raw_decode(s, i)
        except Exception:
            i = s.find("{", i + 1)
            continue
        if isinstance(obj, dict):
            best = obj                       # 뒤로 가며 갱신 -> 마지막 최상위 객체가 남는다
        i = s.find("{", max(end, i + 1))
    if best is None:
        raise ValueError("no json object")
    return best


def exec_cursor(prompt, schema, timeout, model=None, cwd=None, tag=None, tools=None):
    """Cursor Agent CLI headless (-p --mode ask). Read-only. There is no schema flag, so the schema is appended to the
    prompt and enforced by validate() (failure = rework). Envelope: {"type":"result","subtype":"success",
    "is_error":false,"result":"<text>","session_id":..,"usage":{"inputTokens","outputTokens",...}} — no cost, no model."""
    cmd = cursor_cmd()
    if not cmd:
        return None, {"executor": "cursor", "error": "cursor-agent 를 찾지 못함: GE_CURSOR 를 설정", "duration_s": 0.0}
    here = tempfile.mkdtemp(prefix="ge-cursor-")
    full = (prompt + "\n\nOutput contract: reply with ONE JSON object matching this JSON Schema. "
            "No prose, no code fences, no keys outside the schema.\n" + json.dumps(schema, ensure_ascii=False))
    prompt_path = os.path.join(here, "prompt.txt")
    with open(prompt_path, "w", encoding="utf-8") as f:
        f.write(full)
    model = model or os.environ.get("GE_CURSOR_MODEL")
    cmd = cmd + ["-p", "--output-format", "json", "--mode", "ask", "--trust"] + (["--model", model] if model else [])
    env = {"GE_WORKER": "1", "GE_CWD": cwd or PROJ}
    # The CLI also runs the user's global hooks (~/.cursor/hooks.json, plugin hooks). When those break, every tool
    # call is blocked. Point HOME/USERPROFILE/CURSOR_CONFIG_DIR at a clean temp dir (auth stays in the OS store).
    # GE_CURSOR_ISOLATE=0 turns this off.
    if os.environ.get("GE_CURSOR_ISOLATE", "1") != "0":
        iso = os.environ.get("GE_CURSOR_CONFIG_DIR") or os.path.join(tempfile.gettempdir(), "ge-cursor-home")
        os.makedirs(os.path.join(iso, ".cursor"), exist_ok=True)
        env.update({"CURSOR_CONFIG_DIR": os.path.join(iso, ".cursor"), "USERPROFILE": iso, "HOME": iso})
    t0 = time.time()
    code, out, err = run_headless(cmd, here, timeout, env=env, stdin_file=prompt_path)
    with open(os.path.join(here, "stdout.jsonl"), "w", encoding="utf-8", errors="replace") as f:
        f.write(out)
    meta = {"executor": "cursor", "duration_s": round(time.time() - t0, 1), "exit": code, "model": model, "call_dir": here}
    if code is None:
        meta["error"] = err or "timeout"
        return None, meta
    if code != 0 and not out.strip():
        meta["error"] = err[-400:]
        return None, meta
    results = [l for l in _json_lines(out) if l.get("type") == "result"]
    if not results:
        meta["error"] = "stdout 에 result 없음"
        if err:
            meta["stderr"] = err[-200:]
        return None, meta
    raw = results[-1]
    u = raw.get("usage") or {}
    sid = raw.get("session_id") or ""
    meta.update({"input_tokens": u.get("inputTokens"), "output_tokens": u.get("outputTokens"),
                 "cache_read": u.get("cacheReadTokens"), "cache_write": u.get("cacheWriteTokens"),
                 "session_sha": sha256_text(str(sid))[:12] if sid else None})
    if raw.get("is_error") or raw.get("subtype") not in (None, "success"):
        meta["error"] = str(raw.get("result") or raw.get("subtype"))[-400:]
        return None, meta
    text = raw.get("result")
    if not isinstance(text, str):
        meta["error"] = "result 없음"
        return None, meta
    try:
        payload = _trailing_json(text)
    except Exception:
        meta["error"] = "result 가 JSON 이 아님"
        meta["result_head"] = text[:120]
        return None, meta
    return payload, meta


def _codex_strict_schema(schema):
    """Codex/OpenAI strict JSON Schema copy.
    GE 의 원본 schema 는 그대로 validate() 에 쓴다. 이 복사본만 모든 object 에
    additionalProperties:false 와 properties 전체 required 를 채워 CLI strict 모드와 맞춘다."""
    if isinstance(schema, list):
        return [_codex_strict_schema(x) for x in schema]
    if not isinstance(schema, dict):
        return schema
    out = {k: _codex_strict_schema(v) for k, v in schema.items()}
    if out.get("type") == "object" or "properties" in out:
        props = out.get("properties") or {}
        out["properties"] = {k: _codex_strict_schema(v) for k, v in props.items()}
        out["additionalProperties"] = False
        out["required"] = list(props.keys())
    if "items" in out:
        out["items"] = _codex_strict_schema(out["items"])
    for key in ("anyOf", "oneOf", "allOf"):
        if key in out:
            out[key] = [_codex_strict_schema(x) for x in out[key]]
    return out


def _codex_model(model):
    """CLI model name or None (= the CLI's own default). Provider-prefixed selectors are rejected."""
    m = model or os.environ.get("GE_CODEX_MODEL")
    if m and "/" in str(m):
        return None, (f"Codex CLI model must be a CLI model name, not a provider selector {m!r}. "
                      f"Use --model {str(m).split('/', 1)[1]!r}.")
    return m, None


def _codex_events(text):
    events = []
    for line in (text or "").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            events.append(json.loads(line))
        except Exception:
            pass
    return events


def _codex_event_error(events):
    for ev in events:
        typ = str(ev.get("type") or ev.get("event") or "")
        if typ in ("turn.failed", "error") or typ.endswith(".failed"):
            msg = ev.get("message") or ev.get("error") or ev.get("reason") or ev.get("content") or typ
            if isinstance(msg, dict):
                msg = msg.get("message") or msg.get("error") or msg
            return str(msg)[-400:]
        if ev.get("failed") is True or ev.get("is_error") is True:
            msg = ev.get("error") or ev.get("message") or "codex error"
            if isinstance(msg, dict):
                msg = msg.get("message") or msg.get("error") or msg
            return str(msg)[-400:]
    return None


def _first_present(d, *keys):
    for k in keys:
        if k in d:
            return d.get(k)
    return None


def _codex_usage(events):
    meta = {}
    for ev in events:
        sid = ev.get("session_id") or ev.get("sessionId") or ev.get("conversation_id") or ev.get("thread_id")
        if sid and "session_sha" not in meta:
            meta["session_sha"] = sha256_text(str(sid))[:12]
        u = ev.get("usage") or ev.get("token_usage")
        if not isinstance(u, dict) or not u:
            continue
        vals = {
            "input_tokens": _first_present(u, "input_tokens", "inputTokens", "prompt_tokens"),
            "output_tokens": _first_present(u, "output_tokens", "outputTokens", "completion_tokens"),
            "cache_read": _first_present(u, "cache_read_input_tokens", "cacheReadTokens", "cached_input_tokens"),
            "cache_write": _first_present(u, "cache_write_input_tokens", "cacheWriteTokens"),
            "reasoning_output_tokens": _first_present(u, "reasoning_output_tokens", "reasoningOutputTokens"),
        }
        meta.update({k: v for k, v in vals.items() if v is not None})
    return {k: v for k, v in meta.items() if v is not None}


def exec_codex(prompt, schema, timeout, model=None, cwd=None, tag=None, tools=None):
    """Codex CLI worker. Read-only sandbox, strict schema file, final JSON from --output-last-message.
    No shell interpolation and no dangerous bypass. The worker cwd is passed with -C and via GE_CWD."""
    cmd0 = codex_cmd()
    if not cmd0:
        return None, {"executor": "codex", "error": "codex 실행 파일을 찾지 못함: GE_CODEX 를 설정", "duration_s": 0.0}
    model, model_err = _codex_model(model)
    if model_err:
        return None, {"executor": "codex", "error": model_err, "duration_s": 0.0}
    here = tempfile.mkdtemp(prefix="ge-codex-")
    prompt_path = os.path.join(here, "prompt.txt")
    schema_path = os.path.join(here, "schema.json")
    last_path = os.path.join(here, "last-message.txt")
    with open(prompt_path, "w", encoding="utf-8") as f:
        f.write(prompt + "\n\nReturn exactly one JSON object matching the supplied output schema. No prose, no fences.\n")
    with open(schema_path, "w", encoding="utf-8") as f:
        json.dump(_codex_strict_schema(schema), f, ensure_ascii=False)
    run_cwd = cwd or PROJ
    cmd = cmd0 + ["exec"] + (["--model", model] if model else []) + ["--sandbox", "read-only", "--json",
                  "--output-schema", schema_path, "--output-last-message", last_path,
                  "--ephemeral", "--ignore-user-config", "--skip-git-repo-check", "-C", run_cwd, "-"]
    env = {"GE_WORKER": "1", "GE_CWD": run_cwd}
    t0 = time.time()
    code, out, err = run_headless(cmd, here, timeout, env=env, stdin_file=prompt_path)
    for name, data in (("stdout.jsonl", out), ("stderr.txt", err)):
        if data:
            with open(os.path.join(here, name), "w", encoding="utf-8", errors="replace") as f:
                f.write(data)
    events = _codex_events(out)
    meta = {"executor": "codex", "duration_s": round(time.time() - t0, 1), "exit": code,
            "model": model, "call_dir": here}
    meta.update(_codex_usage(events))
    if code is None:
        meta["error"] = err or "timeout"
        return None, meta
    ev_err = _codex_event_error(events)
    if code != 0:
        meta["error"] = (err or ev_err or out or "codex nonzero exit")[-400:]
        return None, meta
    if ev_err:
        meta["error"] = ev_err
        return None, meta
    if not os.path.isfile(last_path):
        meta["error"] = "output-last-message 없음"
        return None, meta
    text = _rt(last_path, encoding="utf-8", errors="replace")
    if not text.strip():
        meta["error"] = "output-last-message 비어 있음"
        return None, meta
    try:
        payload = json.loads(_strip_fences(text))
    except Exception:
        meta["error"] = "result 가 JSON 이 아님"
        meta["result_head"] = text[:120]
        return None, meta
    if not isinstance(payload, dict):
        meta["error"] = "result 가 JSON object 가 아님"
        return None, meta
    return payload, meta


