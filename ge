def resolved_executor(node, run_executor):
    return node.get("executor") or run_executor


def grok_generate_requires_read(node, run_executor):
    """A grok producing node (patches/new_files) needs tools=read.

    Without it GROK_OVERRIDE says 'Do not use tools', so the worker never opens the file and returns
    placeholder patches. Cursor runs in --mode ask and does not need this."""
    if resolved_executor(node, run_executor) != "grok":
        return None
    if node.get("kind") == "verify":
        return None
    props = ((node.get("schema") or {}).get("properties") or {})
    if "patches" not in props and "new_files" not in props:
        return None
    if node.get("tools") == "read":
        return None
    return (f"{node.get('id')}: grok 생성 노드는 tools=read 가 필요하다 "
            "(없으면 Do not use tools → placeholder). Cursor 워커는 이 칸이 필요 없다.")


def patch_old_str_anchors(payload, cwd):
    """패치 old_str 이 대상 파일에 정확히 1번 있어야 한다. 스키마 길이만 보면 placeholder 가 통과한다."""
    if not isinstance(payload, dict):
        return []
    patches = payload.get("patches")
    if not isinstance(patches, list):
        return []
    errs = []
    for i, p in enumerate(patches):
        if not isinstance(p, dict):
            continue
        rel, old = p.get("file"), p.get("old_str")
        if not rel or not isinstance(old, str):
            continue
        path = rel if os.path.isabs(rel) else os.path.join(cwd or PROJ, rel)
        if not os.path.isfile(path):
            errs.append(f"patches[{i}]: 파일 없음 {rel}")
            continue
        n = _rt(path, encoding="utf-8", errors="replace").count(old)
        if n != 1:
            errs.append(f"patches[{i}]: old_str {n}회(1이어야 함) {rel}")
    return errs


