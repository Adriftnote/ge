def _rel(path):
    """Path relative to the current directory (absolute if on another drive)."""
    try:
        return os.path.relpath(path)
    except ValueError:
        return path


class Run:
    def __init__(self, spec, run_id, executor, model=None, inputs_kv=None, max_cost=None,
                 baseline=True, resume=None, resume_from=None):
        self.spec, self.run_id, self.executor, self.model = spec, run_id, executor, model
        self.baseline = baseline                      # 워커 전에 probe 를 원본에 한 번 돌린다 (--no-baseline 으로 끔)
        self.resume, self.resume_from = resume, resume_from      # 이전 런 id, "guard"|"verify"
        self.cause = None                             # 실패 원인 한 줄 (run_aborted / run_done 에 실린다)
        self.inputs_kv = inputs_kv or {}
        self.max_cost = max_cost          # 누적 비용 상한(USD). 실행자가 비용을 줄 때만 보인다 — Cursor 는 안 준다.
        self.spent = 0.0
        self.dir = os.path.join(GE_DIR, "runs", run_id)
        os.makedirs(os.path.join(self.dir, "artifacts"), exist_ok=True)
        self.ledger = open(os.path.join(self.dir, "ledger.jsonl"), "a", encoding="utf-8")
        self.produced = {}
        self.contract = spec.get("_contract")
        self.preflights, self.probe_result, self.gate_result = [], None, None
        self.ok_nodes = set()
        self.call_error = None
        # --input k=v 를 script 노드(라우터 등)도 읽을 수 있게 run 디렉터리에 남긴다. 본문은 사용자가 준 값뿐이다.
        with open(os.path.join(self.dir, "inputs.json"), "w", encoding="utf-8") as f:
            json.dump(self.inputs_kv, f, ensure_ascii=False, indent=1)

    def log(self, **row):
        row.setdefault("ts", now())
        self.ledger.write(json.dumps(row, ensure_ascii=False) + "\n"); self.ledger.flush()

    def capped(self):
        return self.max_cost is not None and self.spent >= self.max_cost

    def call(self, node, prompt, attempt, fb_errs=None):
        ex = node.get("executor", self.executor)
        fb_n = feedback_count(fb_errs)        # 이 호출 프롬프트에 붙은 직전 오류 건수 (계측 전용)
        fb = {"retry_feedback": fb_n > 0, "feedback_errors": fb_n}
        if self.executor == "stub":
            ex = "stub"                            # a stub run never calls a real model
        fn = EXECUTORS[ex.split(":")[0]]           # "claude:other" = same CLI, separate call
        schema = VERDICTS_SCHEMA if node.get("kind") == "verify" and "schema" not in node else node["schema"]
        if self.capped():
            errs = [f"비용 상한 초과: ${self.spent:.4f} >= ${self.max_cost}"]
            self.log(event="call", node=node["id"], attempt=attempt, ok=False, errors=errs, executor=ex,
                     error=errs[0], spent_usd=round(self.spent, 4), capped=True, **fb)
            return None, errs
        cwd = node.get("cwd")                      # run the worker in this folder (spec-relative allowed)
        if cwd and not os.path.isabs(cwd):
            cwd = proj_path(cwd)
        model = node.get("model") or self.model
        if node.get("kind") == "verify" and node.get("verify_thinking") and model:
            model = re.sub(r"-thinking-\w+$", "-thinking-" + node["verify_thinking"], model)
        if ex == "stub" and node.get("stub_output"):
            # canned output for offline examples and tests. It still goes through validate().
            payload = json.loads(_rt(proj_path(node["stub_output"]), encoding="utf-8"))
            meta = {"executor": "stub", "duration_s": 0.0, "model": "stub", "input_tokens": 0, "output_tokens": 0,
                    "cost_usd": 0.0, "stub_output": node["stub_output"]}
        else:
            payload, meta = fn(prompt, schema, node.get("timeout", 600), model, cwd=cwd,
                               tag=f"{self.run_id}-{node['id']}-a{attempt}", tools=node.get("tools"))
        self.spent += meta.get("cost_usd") or 0.0
        errs = validate(payload, schema) if payload is not None else [meta.get("error", "no payload")]
        # Real workers only: a placeholder patch whose old_str is not in the file is rejected here.
        # The stub fills placeholders, so its anchors are not checked.
        if not errs and payload is not None and ex.split(":")[0] in ("cursor", "grok", "claude", "codex"):
            errs += patch_old_str_anchors(payload, cwd or PROJ)
        self.log(event="call", node=node["id"], attempt=attempt, ok=not errs, errors=errs[:5],
                 spent_usd=round(self.spent, 4), **fb, **meta)
        if errs:
            self.call_error = f"{node['id']}: {errs[0]}"[:300]
        return (payload if not errs else None), errs

    def route_allows(self, node):
        """Return (allowed, reason). `when` routes a node on an upstream artifact value.

        when: {"node": "route", "key": "branch", "equals": "code"}
        when: {"node": "route", "key": "branch", "in": ["code", "doc"]}
        Missing upstream/keys are treated as a skip, never as an error.
        """
        cond = node.get("when")
        if not cond:
            return True, None
        if not isinstance(cond, dict) or not cond.get("node"):
            return False, "when 형식 오류 (node 필요)"
        src = self.produced.get(cond["node"])
        if src is None:
            return False, f"when 상류 없음: {cond['node']}"
        val = src
        for part in str(cond.get("key", "branch")).split("."):
            if isinstance(val, dict) and part in val:
                val = val[part]
            else:
                return False, f"when 키 없음: {cond.get('key', 'branch')}"
        if "equals" in cond:
            ok = val == cond["equals"]
            return ok, None if ok else f"when 불일치: {val!r} != {cond['equals']!r}"
        if "in" in cond:
            allowed = cond["in"] if isinstance(cond["in"], list) else [cond["in"]]
            ok = val in allowed
            return ok, None if ok else f"when 불일치: {val!r} not in {allowed!r}"
        return False, "when 조건 없음 (equals 또는 in)"

    def _guard_artifact(self, name, payload):
        path = os.path.join(self.dir, "artifacts", name + ".json")
        with open(path, "w", encoding="utf-8") as f:
            json.dump(payload, f, ensure_ascii=False, indent=1)
        return path

    def guard_preflight(self, node):
        """모델 호출 전. 계약 입력을 코디가 읽고(해시 대조) 워커 cwd 에서도 닿는지 본다. 실패 = 노드 시작 안 함."""
        pre = guard.preflight(self.contract, node, PROJ)
        self.preflights.append(pre)
        path = self._guard_artifact("guard-preflight-" + node["id"], pre)
        self.log(event="guard", phase="preflight", node=node["id"], ok=pre["ok"], problems=pre["problems"][:5],
                 artifact=_rel(path))
        if not pre["ok"]:
            self.cause = f"preflight {node['id']}: {pre['problems'][0]}"
        return pre["ok"]

    def guard_baseline(self):
        """Run the probe once on the original (an empty run folder, no patch) before any worker.
        If the original already violates the probe, the facts are wrong: stop before paying for a worker.
        The probe gets GE_PROBE_BASELINE=1."""
        c = self.contract
        if not (self.baseline and c and c.get("runtime_checks") and c.get("probe")):
            return True
        tmp = tempfile.mkdtemp(prefix="ge-baseline-")
        try:
            res = guard.run_probe(c, tmp, PROJ, baseline=True)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
        path = self._guard_artifact("guard-baseline", res)
        self.log(event="guard", phase="baseline", ok=res["ok"], problems=res["problems"][:5],
                 checks={x["id"]: bool(x.get("ok")) for x in res.get("checks", [])}, artifact=_rel(path))
        if not res["ok"]:
            self.cause = "facts 오류 — 원본(패치 전)이 이미 probe 위반: " + res["problems"][0]
            print("facts 오류: 원본이 이미 probe 를 통과하지 못한다. 워커를 부르지 않았다.", file=sys.stderr)
            for pr in res["problems"]:
                print("  - " + pr, file=sys.stderr)
            print("  probe/facts 를 고치거나 --no-baseline 으로 끈다.", file=sys.stderr)
        return res["ok"]

    def guard_probe(self, node):
        """생산 노드 산출 뒤. probe 스크립트를 격리 실행해 checks 를 남긴다. 계약에 runtime_checks 가 있을 때만."""
        if not self.contract or not self.contract.get("runtime_checks"):
            return True
        if self.resume_from == "verify":         # probe 재사용: 이전 런의 결과를 그대로 (verify 부터 다시)
            old = os.path.join(GE_DIR, "runs", self.resume, "artifacts", "guard-probe.json")
            if os.path.isfile(old):
                self.probe_result = json.loads(_rt(old, encoding="utf-8"))
                self._guard_artifact("guard-probe", self.probe_result)
                self.log(event="guard", phase="runtime_probe", node=node["id"], ok=self.probe_result["ok"],
                         problems=self.probe_result["problems"][:5], resumed_from=self.resume)
                if not self.probe_result["ok"]:
                    self.cause = "probe: " + self.probe_result["problems"][0]
                return self.probe_result["ok"]
        res = guard.run_probe(self.contract, self.dir, PROJ)
        res["after_node"] = node["id"]
        self.probe_result = res
        path = self._guard_artifact("guard-probe", res)
        self.log(event="guard", phase="runtime_probe", node=node["id"], ok=res["ok"], problems=res["problems"][:5],
                 recorded=res.get("recorded", [])[:5],          # record_only 검사의 낙제 — 기록만, 런은 계속
                 checks={c["id"]: bool(c.get("ok")) for c in res.get("checks", [])}, artifact=_rel(path))
        if not res["ok"]:
            self.cause = "probe: " + (res["problems"][0] if res["problems"] else "실패")
        return res["ok"]

    def guard_gate(self, node, payload):
        """verify 산출 뒤. verify fail/unverifiable · probe 실패 · requires 매핑 · 범위 밖 항목 · preflight 잔여.
        하나라도 걸리면 False -> Run.run 이 run_aborted. verify verdict 는 건드리지 않는다."""
        res = guard.acceptance_gate(self.contract, self.dir, self.produced, payload, self.probe_result, self.preflights)
        self.gate_result = res
        path = self._guard_artifact("guard-acceptance", res)
        self.log(event="guard", phase="acceptance_gate", node=node["id"], ok=res["ok"],
                 blocks=[b.get("rule") for b in res["blocks"]][:8],
                 needs_approval=[x["key"] for x in res["needs_approval"]][:8], artifact=_rel(path))
        if not res["ok"]:
            b = res["blocks"][0]
            self.cause = "gate " + b.get("rule", "") + (f" {b['item']}" if b.get("item") else "") + ": " + (b.get("why") or "")[:160]
        return res["ok"]

    def resume_payload(self, node):
        """--resume: 이전 런의 artifacts/<노드>.json 을 재사용할 수 있으면 payload, 아니면 None (model 노드만, 스키마 통과 시)."""
        if not self.resume or node.get("kind", "model") != "model" or node.get("fanout") or "schema" not in node:
            return None
        p = os.path.join(GE_DIR, "runs", self.resume, "artifacts", node["id"] + ".json")
        if not os.path.isfile(p):
            return None
        payload = json.loads(_rt(p, encoding="utf-8"))
        return payload if payload and not validate(payload, node["schema"]) else None

    def apply_block(self, node):
        """An apply node runs only if every input succeeded, every verify input has only `pass` verdicts,
        and (with a contract) the acceptance gate passed. Returns the reason to block, or None.
        This holds with or without a contract and regardless of `required` on upstream nodes."""
        for d in node.get("inputs", []):
            if d not in self.ok_nodes:
                return f"입력 {d} 이(가) 성공하지 않았다"
            dn = next(n for n in self.spec["nodes"] if n["id"] == d)
            if dn.get("kind") == "verify":
                vs = (self.produced.get(d) or {}).get("verdicts") or []
                bad = [v.get("item_id") for v in vs if v.get("verdict") != "pass"]
                if not vs or bad:
                    return f"verify {d} 가 통과하지 않았다: " + (", ".join(map(str, bad)) or "판정 없음")
        if self.contract is not None and not (self.gate_result or {}).get("ok"):
            return "acceptance gate 를 통과하지 않았다"
        return None

    def run_node(self, node):
        nid = node["id"]
        allowed, reason = self.route_allows(node)
        if not allowed:
            self.produced[nid] = {"skipped": True, "reason": reason}
            path = os.path.join(self.dir, "artifacts", f"{nid}.json")
            with open(path, "w", encoding="utf-8") as f:
                json.dump(self.produced[nid], f, ensure_ascii=False, indent=1)
            self.log(event="node_skipped", node=nid, kind=node.get("kind", "model"), reason=reason,
                     role=role_id(self.spec, node), artifact=_rel(path))
            return True
        self.log(event="node_started", node=nid, kind=node.get("kind", "model"), role=role_id(self.spec, node),
                 role_sha=role_sha(node), model=node.get("model") or self.model, executor=node.get("executor", self.executor))
        gerr = grok_generate_requires_read(node, self.executor)
        if gerr:
            self.produced[nid] = {}
            self.log(event="node_done", node=nid, ok=False, artifact=None, artifact_sha=None, verdict=None, why=gerr)
            return False
        if node.get("apply"):
            why = self.apply_block(node)
            if why:
                self.produced[nid] = {}
                self.cause = f"apply {nid}: {why}"
                self.log(event="node_done", node=nid, ok=False, artifact=None, artifact_sha=None, verdict=None, why=why)
                return False
        reuse = self.resume_payload(node)
        if reuse is None and self.contract is not None and node.get("kind") != "script" and not self.guard_preflight(node):
            self.produced[nid] = {}
            self.log(event="node_done", node=nid, ok=False, artifact=None, artifact_sha=None, verdict=None,
                     why="preflight 실패 — 워커를 부르지 않았다")
            return False
        if reuse is not None:
            payload, ok = reuse, True          # resume: 이전 런 산출 재사용 — 워커를 부르지 않는다
            self.log(event="node_resumed", node=nid, resumed_from=self.resume, from_stage=self.resume_from)
        elif node.get("kind") == "script":
            r = subprocess.run([sys.executable, proj_path(node["script"]), self.dir, *node.get("args", [])], cwd=PROJ,
                               capture_output=True, text=True, encoding="utf-8",
                               env={**os.environ, "GE_HOME": GE_HOME, "GE_PROJ": PROJ})   # scripts find ge_lib via GE_HOME
            code, out = r.returncode, r.stdout.strip()
            try:
                payload = json.loads(out) if out else {}
            except Exception:
                payload = {"raw": out[-2000:]}
            self.log(event="script", node=nid, exit=code, ok=code == 0)
            ok = code == 0
            if not ok:
                self.call_error = f"{nid} script exit {code}: " + ((r.stderr or "").strip().splitlines() or [""])[-1][:200]
        else:
            items = self.produced.get(node["fanout"], {}).get("items") if node.get("fanout") else None
            retry = node.get("retry", 1)
            if items is not None:
                results = [None] * len(items)
                def one(i):
                    p, e = None, ["never"]
                    for a in range(1, retry + 2):
                        base = render(node, self.produced, items[i], self.inputs_kv, self.contract)
                        fe = e if a > 1 else None
                        p, e = self.call(node, retry_feedback(base, fe), a, fe)
                        if p is not None or self.capped():
                            break                      # 상한에 걸렸으면 재시도해도 안 풀린다
                    results[i] = p
                with ThreadPoolExecutor(max_workers=node.get("parallel", 4)) as pool:
                    list(pool.map(one, range(len(items))))
                payload = {"items": [r for r in results if r is not None]}
                ok = all(r is not None for r in results)
            else:
                payload, errs = None, ["never"]
                for a in range(1, retry + 2):
                    base = render(node, self.produced, None, self.inputs_kv, self.contract)
                    fe = errs if a > 1 else None
                    payload, errs = self.call(node, retry_feedback(base, fe), a, fe)
                    if payload is not None or self.capped():
                        break
                ok = payload is not None
                payload = payload or {}
        if (node.get("kind") == "verify" and ok and self.contract and isinstance(payload, dict)
                and self.contract.get("mechanical")):
            # mechanical items are not judged by the model; the probe result fills them. The probe wins.
            mv = guard.mechanical_verdicts(self.contract, self.probe_result)
            mine = {v["item_id"] for v in mv}
            payload = {**payload, "verdicts": [v for v in payload.get("verdicts", []) if v.get("item_id") not in mine] + mv}
        self.produced[nid] = payload
        path = os.path.join(self.dir, "artifacts", f"{nid}.json")
        with open(path, "w", encoding="utf-8") as f:
            json.dump(payload, f, ensure_ascii=False, indent=1)
        verdict = None
        if node.get("kind") == "verify" and "verdicts" in payload:
            vs = payload["verdicts"]
            verdict = {"pass": sum(v["verdict"] == "pass" for v in vs), "fail": sum(v["verdict"] == "fail" for v in vs),
                       "unverifiable": sum(v["verdict"] == "unverifiable" for v in vs)}
        self.log(event="node_done", node=nid, ok=ok, artifact=_rel(path),
                 artifact_sha=sha256_text(json.dumps(payload, sort_keys=True, ensure_ascii=False))[:12], verdict=verdict)
        if not ok:
            return ok
        # Deterministic hooks, only for specs with a contract: after a producing node (model or script node that
        # emits patches/new_files) run the probe; after verify run the acceptance gate. With a contract, a single
        # fail/unverifiable verdict aborts the run. Without a contract, a verify fail is recorded and the run goes on.
        kind = node.get("kind", "model")
        if self.contract is None:
            return ok
        if kind == "verify":
            return self.guard_gate(node, payload)
        if kind in ("model", "script") and isinstance(payload, dict) and ("patches" in payload or "new_files" in payload):
            return self.guard_probe(node)
        return ok

    def run(self):
        self.log(event="run_started", run=self.run_id, spec=self.spec["name"], spec_sha=self.spec["_sha"],
                 spec_path=self.spec.get("_path"), ge_sha=ge_sha(), executor=self.executor, model=self.model,
                 host=socket.gethostname(),
                 **({"resumed_from": self.resume, "from_stage": self.resume_from} if self.resume else {}))
        ok_all = True
        try:
            if self.resume:
                if not any(self.resume_payload(n) is not None for n in self.spec["nodes"]):
                    self.cause = f"resume 할 산출이 없다: {self.resume}/artifacts"
                    self.log(event="run_aborted", node=None, cause=self.cause)
                    self.log(event="run_done", ok=False, cause=self.cause)
                    return False
            elif not self.guard_baseline():
                self.log(event="run_aborted", node=None, cause=self.cause)
                self.log(event="run_done", ok=False, cause=self.cause)
                return False
            first_cause = None
            for nid in topo(self.spec):
                node = next(n for n in self.spec["nodes"] if n["id"] == nid)
                self.cause = self.call_error = None
                ok = self.run_node(node)
                if ok:
                    self.ok_nodes.add(nid)
                ok_all = ok_all and ok
                if not ok:
                    first_cause = first_cause or self.cause or self.call_error or f"{nid} 노드 실패"
                    self.cause = first_cause
                if not ok and node.get("required", True):
                    self.log(event="run_aborted", node=nid, cause=self.cause); break
            self.cause = first_cause if not ok_all else None
            self.log(event="run_done", ok=ok_all, **({"cause": self.cause} if self.cause else {}))
        finally:
            self.ledger.close()          # close even on exceptions (Windows cannot delete open files)
        return ok_all


# ---------------- ledger ----------------
def role_id(spec, node):
    """역할 = 명세이름/노드id. 여러 run 에 걸쳐 같은 일을 하는 워커 자리."""
    return f"{spec.get('name')}/{node['id']}"


def role_sha(node):
    """Hash of what the role is told = prompt + rubric + lessons + script. Splits the ledger before/after a lesson."""
    bits = []
    for k in ("prompt", "rubric", "lessons", "script"):
        p = node.get(k)
        if not p:
            continue
        try:
            bits.append(k + ":" + read_rel(p))
        except Exception:
            bits.append(k + ":?" + str(p))
    return sha256_text("\n".join(bits))[:12] if bits else None


def ledger_rows(ge_dir=None):
    """모든 run 의 원장을 읽어 (run, spec, 이벤트) 로 편다. 본문 없음."""
    root = os.path.join(ge_dir or GE_DIR, "runs")
    out = []
    for run in sorted(os.listdir(root)) if os.path.isdir(root) else []:
        path = os.path.join(root, run, "ledger.jsonl")
        if not os.path.isfile(path):
            continue
        spec, started = None, None
        for line in _rt(path, encoding="utf-8").splitlines(True):
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except Exception:
                continue
            if d.get("event") == "run_started":
                spec, started = d.get("spec"), d.get("ts")
            out.append({"run": run, "spec": spec, "run_started": started, **d})
    return out


def roles_table(rows, spec=None, role=None, since=None):
    """역할별 집계. 같은 역할의 role_sha 별로도 쪼갠다 — 교훈 전/후 비교의 단위.

    fail  = 스키마·실행 실패(재작업 유발). verdict = 그 노드가 verify 일 때 판정 합계.
    cost  = 실행자가 준 값만. Cursor 는 가격을 안 줘서 0 이다(토큰으로 봐라).
    """
    node_role = {}
    for r in rows:
        if r.get("event") == "node_started" and r.get("role"):
            node_role[(r["run"], r.get("node"))] = (r["role"], r.get("role_sha"))
    agg = {}
    for r in rows:
        if since and (r.get("run_started") or "") < since:
            continue
        nid = r.get("node")
        if not nid:
            continue
        rid, rsha = node_role.get((r["run"], nid), (f"{r.get('spec')}/{nid}", None))
        if spec and not rid.startswith(spec + "/"):
            continue
        if role and role != rid:
            continue
        a = agg.setdefault((rid, rsha), {"role": rid, "role_sha": rsha, "runs": set(), "calls": 0, "fail": 0,
                                         "rework": 0, "rw": {"fb": [0, 0], "nofb": [0, 0], "unknown": [0, 0]}, "verdict_pass": 0, "verdict_fail": 0, "verdict_unver": 0,
                                         "tokens_in": 0, "tokens_out": 0, "cost_usd": 0.0, "models": set(),
                                         "executors": set(), "reasons": [], "last": None})
        a["runs"].add(r["run"])
        a["last"] = max(a["last"] or "", r.get("ts") or "")
        if r["event"] == "node_started":
            if r.get("model"):
                a["models"].add(r["model"])
            if r.get("executor"):
                a["executors"].add(r["executor"])
        elif r["event"] == "call":
            a["calls"] += 1
            a["tokens_in"] += r.get("input_tokens") or 0
            a["tokens_out"] += r.get("output_tokens") or 0
            a["cost_usd"] += r.get("cost_usd") or 0.0
            if r.get("model"):
                a["models"].add(r["model"])
            if r.get("attempt", 1) > 1:
                a["rework"] += 1
                k = "unknown" if "retry_feedback" not in r else ("fb" if r["retry_feedback"] else "nofb")
                a["rw"][k][0] += 1                    # 재작업 호출 수
                a["rw"][k][1] += 1 if r.get("ok") else 0   # 그중 통과
            if not r.get("ok"):
                a["fail"] += 1
                a["reasons"] += [" ".join(str(e).split())[:80] for e in (r.get("errors") or [])]
        elif r["event"] == "node_done" and r.get("verdict"):
            v = r["verdict"]
            a["verdict_pass"] += v.get("pass", 0)
            a["verdict_fail"] += v.get("fail", 0)
            a["verdict_unver"] += v.get("unverifiable", 0)
    out = []
    for a in agg.values():
        vt = a["verdict_pass"] + a["verdict_fail"] + a["verdict_unver"]
        rw = a.pop("rw")
        out.append({**a, "rework_fb": rw["fb"][0], "rework_fb_ok": rw["fb"][1],
                    "rework_nofb": rw["nofb"][0], "rework_nofb_ok": rw["nofb"][1],
                    "rework_unknown": rw["unknown"][0], "rework_unknown_ok": rw["unknown"][1], "runs": len(a["runs"]), "models": sorted(a["models"]), "executors": sorted(a["executors"]),
                    "cost_usd": round(a["cost_usd"], 4), "verdict_total": vt,
                    "verdict_rate": round(a["verdict_pass"] / vt, 3) if vt else None,
                    "rework_rate": round(a["rework"] / a["calls"], 3) if a["calls"] else None,
                    "top_reasons": [r for r, _ in collections.Counter(a["reasons"]).most_common(3)]})
    for o in out:
        o.pop("reasons", None)
    return sorted(out, key=lambda o: (-o["calls"], o["role"]))


def format_roles(table):
    w = max([len(o["role"]) for o in table] + [6])
    lines = [f"{'역할'.ljust(w)}  {'sha':12}  {'run':>3} {'call':>4} {'재작업':>6} {'실패':>4}  {'합격':>9}  {'토큰in':>8} {'토큰out':>7}  {'비용$':>7}  모델"]
    for o in table:
        vr = f"{o['verdict_pass']}/{o['verdict_total']}" if o["verdict_total"] else "-"
        lines.append(f"{o['role'].ljust(w)}  {(o['role_sha'] or '-'):12}  {o['runs']:>3} {o['calls']:>4} "
                     f"{o['rework']:>6} {o['fail']:>4}  {vr:>9}  {o['tokens_in']:>8} {o['tokens_out']:>7}  "
                     f"{o['cost_usd']:>7}  {','.join(m.split('-')[0] for m in o['models']) or '-'}")
        if o["rework"]:
            lines.append(" " * (w + 2) + f"└ 재작업 뒤 통과: 피드백있음 {o['rework_fb_ok']}/{o['rework_fb']} · "
                         f"없음 {o['rework_nofb_ok']}/{o['rework_nofb']} · unknown {o['rework_unknown_ok']}/{o['rework_unknown']}")
        if o["top_reasons"]:
            lines.append(" " * (w + 2) + "└ 실패이유: " + " | ".join(o["top_reasons"]))
    return "\n".join(lines)


def metrics(run_dir):
    """원장 -> 지표 5개. 본문 없음."""
    rows = [json.loads(l) for l in _rt(os.path.join(run_dir, "ledger.jsonl"), encoding="utf-8").splitlines(True) if l.strip()]
    start = next((r for r in rows if r["event"] == "run_started"), {})
    calls = [r for r in rows if r["event"] == "call"]
    nodes_done = [r for r in rows if r["event"] == "node_done"]
    # 1) 합격률: verify 노드 verdict 합계
    vp = sum((r.get("verdict") or {}).get("pass", 0) for r in nodes_done)
    vf = sum((r.get("verdict") or {}).get("fail", 0) for r in nodes_done)
    # 2) 재작업과 원인: attempt>1 인 호출. 원인 = 직전 시도의 오류 종류
    rework = [r for r in calls if r["attempt"] > 1]
    cause = {}
    for r in rework:
        prev = next((p for p in calls if p["node"] == r["node"] and p["attempt"] == r["attempt"] - 1), {})
        k = "schema" if any("필수" in e or "허용" in e or "아님" in e or "enum" in e or "길이" in e for e in prev.get("errors", [])) else \
            "worker-error" if prev.get("error") else "other"
        cause[k] = cause.get(k, 0) + 1
    # 3) 토큰·비용
    tok_in = sum(r.get("input_tokens") or 0 for r in calls)
    tok_out = sum(r.get("output_tokens") or 0 for r in calls)
    cost = round(sum(r.get("cost_usd") or 0 for r in calls), 4)
    # 4) 규칙·명세 버전 = start 에 있음
    # 5) 사람 개입
    notes = [r for r in rows if r["event"] == "note"]
    # 6) node table: how the work was split and where rework happened, one line per node.
    nodes = node_table(rows)
    models = [r.get("model") for r in calls if r.get("model")]
    uniq = list(dict.fromkeys(models))
    model = start.get("model") or (uniq[0] if len(uniq) == 1 else ",".join(uniq) if uniq else None)
    return {"run": start.get("run"), "spec": start.get("spec"), "spec_sha": start.get("spec_sha"),
            "ge_sha": start.get("ge_sha"), "executor": start.get("executor"),
            "model": model, "started": start.get("ts"),
            "ok": next((r["ok"] for r in rows if r["event"] == "run_done"), None),
            "nodes": len(nodes_done), "calls": len(calls),
            "verify_pass": vp, "verify_fail": vf,
            "rework": len(rework), "rework_cause": cause,
            "tokens_in": tok_in, "tokens_out": tok_out, "cost_usd": cost,
            "human_interventions": len(notes),
            "node_table": nodes}


def node_table(rows):
    """원장 -> 노드별 요약 리스트 (위상 순서 = node_started 순). 본문·산출물 내용 없음.

    필드: id, kind, calls(호출 수), attempts_max(한 항목 최대 시도), fanout(항목 수 | null),
          ok, verdict(verify 만), artifact_sha(12), errors(마지막 실패 종류 최대 3개), started/ended.
    """
    order, info = [], {}
    for r in rows:
        ev, nid = r.get("event"), r.get("node")
        if not nid:
            continue
        if nid not in info:
            order.append(nid)
            info[nid] = {"id": nid, "kind": None, "calls": 0, "attempts_max": 0, "fanout": None,
                         "ok": None, "verdict": None, "artifact_sha": None, "errors": [],
                         "started": None, "ended": None}
        n = info[nid]
        if ev == "node_started":
            n["kind"] = r.get("kind", "model"); n["started"] = r.get("ts")
        elif ev == "call":
            n["calls"] += 1
            n["attempts_max"] = max(n["attempts_max"], r.get("attempt") or 0)
            if not r.get("ok"):
                for e in (r.get("errors") or [])[:3]:
                    kind = ("schema" if any(t in e for t in ("필수", "허용", "아님", "enum", "길이")) else
                            "worker-error" if r.get("error") else "other")
                    if kind not in n["errors"]:
                        n["errors"].append(kind)
        elif ev == "script":
            n["calls"] += 1; n["attempts_max"] = max(n["attempts_max"], 1)
            if not r.get("ok") and "script-exit" not in n["errors"]:
                n["errors"].append("script-exit")
        elif ev == "node_done":
            n["ok"] = r.get("ok"); n["verdict"] = r.get("verdict"); n["artifact_sha"] = r.get("artifact_sha")
            n["ended"] = r.get("ts")
        elif ev == "run_aborted":
            n["ok"] = False if n["ok"] is None else n["ok"]
    # fanout 항목 수: 같은 노드에 attempt=1 호출이 여러 개면 그 수가 항목 수
    first_attempts = {}
    for r in rows:
        if r.get("event") == "call" and r.get("attempt") == 1:
            first_attempts[r["node"]] = first_attempts.get(r["node"], 0) + 1
    for nid, cnt in first_attempts.items():
        if cnt > 1 and nid in info:
            info[nid]["fanout"] = cnt
    return [info[n] for n in order]


def _call_text(call_dir):
    """호출 디렉터리에서 워커가 실제로 뱉은 전문을 꺼낸다. cursor=stream-json 의 마지막 result,
    grok=end 이벤트의 structuredOutput, 아니면 stdout 원문."""
    if not call_dir or not os.path.isdir(call_dir):
        return None, "call_dir 없음 (옛 런이거나 임시 디렉터리가 지워졌다)"
    for name in ("stdout.jsonl", "stdout.json"):
        p = os.path.join(call_dir, name)
        if not os.path.exists(p):
            continue
        raw = _rt(p, encoding="utf-8-sig", errors="replace")
        lines = _json_lines(raw)
        for l in reversed(lines):
            if l.get("type") == "result" and isinstance(l.get("result"), str):
                return l["result"], f"{name}: cursor result ({len(l['result'])}자)"
            if l.get("type") == "end":
                so = l.get("structuredOutput")
                if so is not None:
                    return json.dumps(so, ensure_ascii=False, indent=1), f"{name}: grok structuredOutput"
        return raw, f"{name}: 원문 그대로 ({len(raw)}자)"
    return None, "stdout 파일 없음: " + call_dir


def trace(run_dir, node=None, attempt=None, out=None):
    """Dump a worker's raw output. The ledger keeps only a 120-char head, which often hides the cause.
    Writes to a file by default — do not paste raw output into a chat."""
    path = os.path.join(run_dir, "ledger.jsonl")
    if not os.path.isfile(path):
        return {"ok": False, "error": "원장 없음: " + path}
    calls = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            try:
                d = json.loads(line)
            except Exception:
                continue
            if d.get("event") == "call":
                calls.append(d)
    picked = [c for c in calls
              if (node is None or c.get("node") == node) and (attempt is None or c.get("attempt") == attempt)]
    if node is None and attempt is None:
        bad = [c for c in picked if not c.get("ok")]
        picked = bad or picked[-1:]                 # 안 고르면 실패한 것들, 그것도 없으면 마지막
    items = []
    for c in picked:
        cdir = c.get("call_dir")
        text, how = _call_text(cdir)
        item = {"node": c.get("node"), "attempt": c.get("attempt"), "ok": c.get("ok"),
                "errors": c.get("errors"), "executor": c.get("executor"), "model": c.get("model"),
                "call_dir": cdir, "source": how, "chars": len(text) if text else 0}
        if text is not None:
            dst = out or os.path.join(run_dir, "artifacts", f"trace-{c.get('node')}-a{c.get('attempt')}.txt")
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(dst, "w", encoding="utf-8", newline="\n") as f:
                f.write(text)
            item["written"] = _rel(dst)
            item["head"] = " ".join(text[:200].split())
        items.append(item)
    return {"ok": True, "calls": len(calls), "traced": items,
            "note": "원문은 파일에 있다. 대화창에 붙이지 말고 필요한 조각만 코드로 꺼내라."}


# ---------------- topology stats (ge stats --topologies) ----------------
def _iter_spec_files(spec_roots):
    seen = set()
    for root in spec_roots:
        if not root or not os.path.isdir(root):
            continue
        for path in sorted(glob.glob(os.path.join(root, "*.json"))):
            ap = os.path.abspath(path)
            if ap not in seen:
                seen.add(ap)
                yield path


def _load_spec_for_stats(path):
    try:
        with open(path, encoding="utf-8") as f:
            obj = json.load(f)
    except Exception:
        return None
    if not isinstance(obj, dict) or not isinstance(obj.get("nodes"), list):
        return None
    if not obj.get("name"):
        obj["name"] = os.path.splitext(os.path.basename(path))[0]
    return obj


def _node_topology_label(node, include_ids=False):
    kind = node.get("kind", "model")
    label = f"{node.get('id', '?')}:{kind}" if include_ids else kind
    flags = []
    if node.get("fanout"):
        flags.append("fanout")
    if node.get("tools"):
        flags.append("tools=" + str(node.get("tools")))
    if node.get("when"):
        flags.append("routed")
    return label + ("[" + ",".join(flags) + "]" if flags else "")


def spec_topology_signature(spec, include_ids=False):
    """Hashable, body-free graph signature of a spec: node kinds in declaration order + edges."""
    nodes = spec.get("nodes") or []
    id_to_idx = {n.get("id"): i for i, n in enumerate(nodes)}
    labels = tuple(_node_topology_label(n, include_ids=include_ids) for n in nodes)
    edges = []
    for i, node in enumerate(nodes):
        for src in node.get("inputs") or []:
            j = id_to_idx.get(src, -1)
            edges.append((j, i, labels[j] if j >= 0 else "?", labels[i]))
    return {"nodes": labels, "edges": tuple(edges)}


def _topology_key(sig):
    return (tuple(sig["nodes"]), tuple(sig["edges"]))


def _workflow_signatures():
    """Scaffold layouts in ge_lib/workflows/*.json as topology keys (so a shape can be matched to a recipe)."""
    from ge_lib import scaffold
    out = {}
    for w in scaffold.workflows():
        wf = scaffold.load_workflow(w["name"])
        nodes = [{**n, "id": n["id"].replace("{patch_node}", "patch")} for n in wf["nodes"]]
        for n in nodes:
            n["inputs"] = [x.replace("{patch_node}", "patch") for x in n.get("inputs", [])]
        out.setdefault(_topology_key(spec_topology_signature({"nodes": nodes})), []).append(w["name"])
    return {k: ", ".join(v) for k, v in out.items()}


def _ledger_summary(path):
    spec, ok, seq = None, None, []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                try:
                    ev = json.loads(line)
                except Exception:
                    continue
                if ev.get("event") == "run_started":
                    spec = ev.get("spec")
                elif ev.get("event") == "node_started":
                    seq.append(ev.get("kind", "model"))
                elif ev.get("event") == "run_done":
                    ok = ev.get("ok")
    except OSError:
        pass
    return {"spec": spec, "ok": ok, "sequence": seq}


PROMOTE_MIN = 2   # a shape used by at least this many specs, with no recipe yet, is a recipe candidate


def ge_stats(spec_roots=None, runs_dir=None, limit=20):
    """Count graph shapes across spec files and ledgers. Shapes used twice or more without a recipe are
    marked promote=true: that is the rule for adding a new scaffold layout (one-off shapes stay one-off)."""
    spec_roots = spec_roots or [os.path.join(os.getcwd(), "graphs"), os.path.join(os.getcwd(), "examples"), os.getcwd()]
    recipes = _workflow_signatures()
    top, name_to_key = collections.OrderedDict(), {}
    nspecs = 0
    for path in _iter_spec_files(spec_roots):
        spec = _load_spec_for_stats(path)
        if not spec:
            continue
        nspecs += 1
        sig = spec_topology_signature(spec)
        key = _topology_key(sig)
        name_to_key.setdefault(spec.get("name"), key)
        item = top.setdefault(key, {"spec_count": 0, "run_count": 0, "ok_runs": 0,
                                    "nodes": list(sig["nodes"]), "edges": [list(e) for e in sig["edges"]],
                                    "workflow": recipes.get(key), "examples": []})
        item["spec_count"] += 1
        if len(item["examples"]) < 8:
            item["examples"].append(_rel(path).replace(os.sep, "/"))
    run_seq = collections.Counter()
    root = runs_dir or os.path.join(GE_DIR, "runs")
    for ledger in sorted(glob.glob(os.path.join(root, "*", "ledger.jsonl"))):
        r = _ledger_summary(ledger)
        run_seq[tuple(r["sequence"])] += 1
        item = top.get(name_to_key.get(r["spec"]))
        if item:
            item["run_count"] += 1
            item["ok_runs"] += 1 if r["ok"] else 0
    for item in top.values():
        item["promote"] = item["workflow"] is None and item["spec_count"] >= PROMOTE_MIN
    topologies = sorted(top.values(), key=lambda x: (-x["spec_count"], -x["run_count"], x["nodes"]))[:limit]
    return {"specs": nspecs, "topologies": topologies,
            "run_sequences": [{"count": c, "shape": " -> ".join(s) or "(none)"} for s, c in run_seq.most_common(limit)]}


def format_ge_stats(stats):
    lines = [f"specs={stats['specs']}", "", "Spec topologies:"]
    for t in stats["topologies"]:
        tag = f"  [recipe: {t['workflow']}]" if t["workflow"] else ("  [promote: used twice, no recipe yet]" if t["promote"] else "")
        lines.append(f"- {t['spec_count']} specs, {t['run_count']} runs ({t['ok_runs']} ok): "
                     f"{' -> '.join(t['nodes']) or '(none)'}{tag}")
        lines.append("  edges: " + (", ".join(f"{a}:{s}→{b}:{d}" for a, b, s, d in t["edges"]) or "-"))
        lines.append("  examples: " + ", ".join(t["examples"]))
    lines += ["", "Observed run node-kind sequences:"]
    lines += [f"- {r['count']} runs: {r['shape']}" for r in stats["run_sequences"]] or ["- (none)"]
    return "\n".join(lines)


# ---------------- progress ----------------
MARK = {"ok": "[v]", "fail": "[x]", "running": "[~]", "skipped": "[-]", "pending": "[ ]"}
MARK_UNI = {"ok": "[✓]", "fail": "[✗]", "running": "[~]", "skipped": "[-]", "pending": "[ ]"}


def _spec_node_order(spec_path):
    """Full node order from the spec file (so nodes not started yet show as [ ]). None if unreadable."""
    if not spec_path or not os.path.isfile(spec_path):
        return None
    try:
        return topo(json.loads(_rt(spec_path, encoding="utf-8")))
    except Exception:
        return None


def run_progress(run_dir):
    """One ledger -> per-node state. No bodies."""
    path = os.path.join(run_dir, "ledger.jsonl")
    info = {"run": os.path.basename(run_dir), "spec": None, "spec_path": None, "ok": None,
            "started_at": None, "ended_at": None, "nodes": [], "verdict": None, "tokens": {}, "spent_usd": 0.0}
    seen, state, kinds, attempts, nstart = [], {}, {}, {}, {}
    calls, fails, models, errs, secs = {}, {}, {}, {}, {}
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                try:
                    ev = json.loads(line)
                except Exception:
                    continue
                e, nid = ev.get("event"), ev.get("node")
                if e == "run_started":
                    info.update(spec=ev.get("spec"), spec_path=ev.get("spec_path"), started_at=ev.get("ts"))
                elif e in ("node_started", "node_skipped"):
                    if nid not in seen:
                        seen.append(nid)
                    state[nid] = "running" if e == "node_started" else "skipped"
                    kinds[nid] = ev.get("kind", "model")
                    nstart[nid] = ev.get("ts")
                elif e == "call":
                    attempts[nid] = max(attempts.get(nid, 0), ev.get("attempt") or 1)
                    calls[nid] = calls.get(nid, 0) + 1
                    if ev.get("model"):
                        models[nid] = ev["model"]
                    if ev.get("duration_s"):
                        secs[nid] = secs.get(nid, 0.0) + float(ev["duration_s"])
                    for key in ("input_tokens", "output_tokens", "cache_read", "cache_write"):
                        if ev.get(key):
                            info["tokens"][key] = info["tokens"].get(key, 0) + int(ev[key])
                    if ev.get("spent_usd"):
                        info["spent_usd"] = round(float(ev["spent_usd"]), 4)
                    if not ev.get("ok"):
                        fails[nid] = fails.get(nid, 0) + 1
                        why = ev.get("errors") or ([ev["error"]] if ev.get("error") else [])
                        if why:
                            errs[nid] = "; ".join(str(x) for x in why)[:200]
                elif e == "node_done":
                    state[nid] = "ok" if ev.get("ok") else "fail"
                    if ev.get("verdict"):
                        info["verdict"] = ev["verdict"]
                elif e == "run_done":
                    info["ok"] = ev.get("ok")
                    info["ended_at"] = ev.get("ts")
    except OSError:
        return info
    order = _spec_node_order(info["spec_path"])
    order = (list(order) + [n for n in seen if n not in order]) if order else seen
    info["nodes"] = [{"id": n, "kind": kinds.get(n), "state": state.get(n, "pending"),
                      "attempts": attempts.get(n, 0), "started": nstart.get(n),
                      "calls": calls.get(n, 0), "fails": fails.get(n, 0),
                      "model": models.get(n), "last_error": errs.get(n),
                      "secs": round(secs.get(n, 0.0), 1)} for n in order]
    info["calls_total"] = sum(calls.values())
    info["fails_total"] = sum(fails.values())
    return info


def progress(limit=8, runs_dir=None):
    root = runs_dir or os.path.join(GE_DIR, "runs")
    dirs = sorted((d for d in glob.glob(os.path.join(root, "*")) if os.path.isfile(os.path.join(d, "ledger.jsonl"))),
                  key=lambda d: os.path.getmtime(os.path.join(d, "ledger.jsonl")), reverse=True)[:limit]
    return [run_progress(d) for d in dirs]


def _elapsed_s(ts):
    """노드가 도는 중일 때 경과초. 화면이 살아 있다는 신호이기도 하다."""
    if not ts:
        return ""
    try:
        started = datetime.datetime.fromisoformat(str(ts)).timestamp()
    except ValueError:
        return ""
    sec = int(max(0, time.time() - started))
    return f"{sec}s" if sec < 90 else f"{sec // 60}m{sec % 60:02d}s"


def format_progress(runs, unicode_marks=True):
    m = MARK_UNI if unicode_marks else MARK
    x = "✗" if unicode_marks else "x"
    lines = []
    for r in runs:
        if r["ok"] is True:
            head = m["ok"]
        elif r["ok"] is False:
            head = m["fail"]
        elif any(n["state"] == "running" for n in r["nodes"]):
            head = m["running"]
        else:
            head = m["pending"]
        v = r.get("verdict") or {}
        tail = f"  {v['pass']} pass / {v['fail']} fail" if v else ""
        lines.append(f"{head} {r['run']}   ({r['spec']}){tail}")
        chain = "   ".join(f"{m[n['state']]} {n['id']}" +
                           (f"*{n['attempts']}" if n["attempts"] > 1 else "") +
                           (f"{x}{n['fails']}" if n.get("fails") else "") +
                           (f" {_elapsed_s(n.get('started'))}" if n["state"] == "running" else "")
                           for n in r["nodes"])
        if chain:
            lines.append(f"    {chain}")
        # Failed calls always show their reason. A "running" node can already be dead and retrying.
        for n in r["nodes"]:
            if n.get("fails"):
                who = f"{n['model']}, " if n.get("model") else ""
                dur = f"{n['secs']:.0f}s" if n.get("secs") else ""
                lines.append(f"      \u21b3 {n['id']} {x}{n['fails']}  {n.get('last_error') or '이유 미기록'}  ({who}{dur})")
    return "\n".join(lines)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="ge", description="work-graph coordinator")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("plan"); p.add_argument("spec")
    p = sub.add_parser("run"); p.add_argument("spec")
    p.add_argument("--executor", default=os.environ.get("GE_EXECUTOR", "claude"), choices=list(EXECUTORS))
    p.add_argument("--run-id"); p.add_argument("--model"); p.add_argument("--input", action="append", default=[])
    p.add_argument("--max-cost", type=float, help="cumulative cost cap (USD); only executors that report cost")
    p.add_argument("--no-baseline", action="store_true", help="skip the probe self-check on the original")
    p.add_argument("--resume", metavar="RUN_ID", help="reuse model-node artifacts of this run (needs --from)")
    p.add_argument("--from", dest="from_stage", choices=["guard", "verify"],
                   help="guard: rerun from the probe / verify: keep the old probe result and rerun verify")
    p = sub.add_parser("note"); p.add_argument("run_dir"); p.add_argument("text")
    p = sub.add_parser("report"); p.add_argument("run_dir"); p.add_argument("--out", help="append the metrics line to this JSONL file")
    p = sub.add_parser("ledger"); p.add_argument("--spec"); p.add_argument("--role"); p.add_argument("--since")
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("lesson", help="one lesson line for a producing node (never for the checker)")
    p.add_argument("spec"); p.add_argument("node"); p.add_argument("text"); p.add_argument("--run")
    p = sub.add_parser("new", help="scaffold a spec (contract slot, separate verify, script apply, lessons)")
    p.add_argument("name"); p.add_argument("--cwd", required=True); p.add_argument("--target", required=True)
    p.add_argument("--workflow", default="patch", help="node layout (ge_lib/workflows/*.json); see `ge workflows`")
    p.add_argument("--node", default="patch"); p.add_argument("--apply", default=None, help="apply script; default generates <spec>/apply.py")
    p.add_argument("--root", default=".", help="folder that gets graphs/<name>.json (default: current directory)")
    p.add_argument("--force", action="store_true")
    sub.add_parser("workflows", help="list scaffold layouts")
    p = sub.add_parser("contract-sha", help="compute contract.inputs sha256; --write updates the spec")
    p.add_argument("spec"); p.add_argument("--write", action="store_true")
    p = sub.add_parser("approve", help="approve an out-of-scope item (file:… / table:…) blocked by the acceptance gate")
    p.add_argument("run_dir"); p.add_argument("item"); p.add_argument("--note")
    p = sub.add_parser("trace", help="write a worker's raw output to a file")
    p.add_argument("run_dir"); p.add_argument("--node"); p.add_argument("--attempt", type=int); p.add_argument("--out")
    p = sub.add_parser("progress", help="node-by-node status of recent runs")
    p.add_argument("--limit", type=int, default=8); p.add_argument("--json", action="store_true")
    p.add_argument("--ascii", action="store_true")
    p = sub.add_parser("fabric", help="find a prompt skeleton in the Fabric patterns (spec-writing aid)")
    p.add_argument("query", nargs="?"); p.add_argument("--show"); p.add_argument("--limit", type=int, default=12)
    p.add_argument("--check", action="store_true", help="compare names and body shas with upstream (no download)")
    p.add_argument("--sync", action="store_true", help="download upstream once and build the local manifest")
    p.add_argument("--dry", action="store_true", help="with --sync: download only, do not write")
    p = sub.add_parser("stats", help="count node/edge shapes across specs and ledgers; marks recipe candidates")
    p.add_argument("--topologies", action="store_true", help="(default output)")
    p.add_argument("roots", nargs="*", help="folders with *.json specs (default: ./graphs ./examples .)")
    p.add_argument("--json", action="store_true"); p.add_argument("--limit", type=int, default=20)
    p = sub.add_parser("check-model", help="check the structural invariants in formal/ with Alloy (needs java + Alloy jar)")
    p.add_argument("--jar", help="Alloy 6 jar (default: $ALLOY_JAR)")
    a = ap.parse_args(argv)
    if a.cmd == "plan":
        spec = load_spec(a.spec)
        print(json.dumps({"name": spec["name"], "spec_sha": spec["_sha"], "order": topo(spec),
                          "kinds": {n["id"]: n.get("kind", "model") for n in spec["nodes"]},
                          "warnings": path_length_warnings(spec, datetime.datetime.now().strftime("%Y%m%dT%H%M%S") + "-" + spec["name"])},
                         ensure_ascii=False, indent=1))
    elif a.cmd == "run":
        spec = load_spec(a.spec)
        run_id = a.run_id or datetime.datetime.now().strftime("%Y%m%dT%H%M%S") + "-" + spec["name"]
        kv = dict(x.split("=", 1) for x in a.input)
        for w in path_length_warnings(spec, run_id):
            print("경고: " + w, file=sys.stderr)
        if bool(a.resume) != bool(a.from_stage):
            print("--resume 과 --from 은 함께 쓴다", file=sys.stderr); sys.exit(2)
        if a.resume and not os.path.isdir(os.path.join(GE_DIR, "runs", a.resume, "artifacts")):
            print(f"resume 대상 런이 없다: {a.resume}", file=sys.stderr); sys.exit(2)
        r = Run(spec, run_id, a.executor, a.model, kv, max_cost=a.max_cost, baseline=not a.no_baseline,
                resume=a.resume, resume_from=a.from_stage)
        ok = r.run()
        out = {"run_dir": _rel(os.path.join(GE_DIR, "runs", run_id)), "ok": ok}
        if not ok and r.cause:
            out["cause"] = r.cause
        print(json.dumps(out, ensure_ascii=False))
        if not ok and r.cause:
            print("실패 원인: " + r.cause)          # last line = what a completion notice shows
        sys.exit(0 if ok else 1)
    elif a.cmd == "note":
        with open(os.path.join(a.run_dir, "ledger.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps({"event": "note", "ts": now(), "text": a.text}, ensure_ascii=False) + "\n")
        print("기록됨")
    elif a.cmd == "ledger":
        t = roles_table(ledger_rows(), spec=a.spec, role=a.role, since=a.since)
        print(json.dumps(t, ensure_ascii=False, indent=1) if a.json else format_roles(t))
    elif a.cmd == "lesson":
        print(json.dumps(add_lesson(a.spec, a.node, a.text, a.run), ensure_ascii=False, indent=1))
    elif a.cmd == "new":
        from ge_lib import scaffold
        print(json.dumps(scaffold.new_spec(a.name, a.cwd, a.target, a.node, a.apply, a.force,
                                          workflow=a.workflow, root=a.root), ensure_ascii=False, indent=1))
    elif a.cmd == "workflows":
        from ge_lib import scaffold
        print(json.dumps(scaffold.workflows(), ensure_ascii=False, indent=1))
    elif a.cmd == "contract-sha":
        r = contract_sha(a.spec, a.write)
        print(json.dumps(r, ensure_ascii=False, indent=1))
        sys.exit(0 if r["ok"] else 1)
    elif a.cmd == "approve":
        print(json.dumps(guard.approve(a.run_dir, a.item, note=a.note), ensure_ascii=False, indent=1))
    elif a.cmd == "trace":
        r = trace(a.run_dir, a.node, a.attempt, a.out)
        print(json.dumps(r, ensure_ascii=False, indent=1))
        sys.exit(0 if r.get("ok") else 1)
    elif a.cmd == "progress":
        rs = progress(limit=a.limit)
        print(json.dumps(rs, ensure_ascii=False, indent=1) if a.json else format_progress(rs, unicode_marks=not a.ascii))
    elif a.cmd == "fabric":
        if a.check:
            r = fabric.check()
        elif a.sync:
            r = fabric.sync(dry=a.dry)
        elif a.show:
            r = fabric.show(a.show, os.path.join(GE_DIR, "fabric"))
        else:
            r = fabric.search(a.query, a.limit)
        print(json.dumps(r, ensure_ascii=False, indent=1))
        sys.exit(0 if r.get("ok") else 1)
    elif a.cmd == "stats":
        r = ge_stats(spec_roots=[os.path.abspath(x) for x in a.roots] or None, limit=a.limit)
        print(json.dumps(r, ensure_ascii=False, indent=1) if a.json else format_ge_stats(r))
    elif a.cmd == "check-model":
        from ge_lib import alloy_check
        sys.exit(alloy_check.main(jar=a.jar))
    elif a.cmd == "report":
        m = metrics(a.run_dir)
        print(json.dumps(m, ensure_ascii=False, indent=1))
        if a.out:
            os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)
            with open(a.out, "a", encoding="utf-8") as f:
                f.write(json.dumps({**m, "kind": "ge-run"}, ensure_ascii=False) + "\n")


if __name__ == "__main__":
    main()
