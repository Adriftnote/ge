def resolve_ge_dir(base=None):
    """Ledger location (.ge): GE_RUNS_DIR (its parent if it ends in /runs) > main checkout of a git
    worktree (so the ledger survives worktree cleanup) > base (current directory)."""
    base = base or os.getcwd()
    env = os.environ.get("GE_RUNS_DIR")
    if env:
        env = os.path.abspath(env)
        return os.path.dirname(env) if os.path.basename(env) == "runs" else env
    try:
        p = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], cwd=base,
                           capture_output=True, text=True, timeout=10)
        c = p.stdout.strip()
        if p.returncode == 0 and c and os.path.basename(os.path.normpath(c)) == ".git":
            return os.path.join(os.path.dirname(os.path.normpath(c)), ".ge")
    except Exception:
        pass
    return os.path.join(base, ".ge")


