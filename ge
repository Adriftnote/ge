def lessons_path(spec_path, node):
    return os.path.join(os.path.splitext(os.path.abspath(spec_path))[0], "lessons", node + ".md")


def add_lesson(spec_path, node, text, run=None):
    """Append one lesson line for a producing node: <spec>/lessons/<node>.md.
    One line, date, optional run id. Long explanations belong in the prompt; here only "do not repeat this".
    Lessons change role_sha, so `ge ledger --role` splits rework before/after the lesson."""
    one = " ".join(text.split())
    if not one:
        raise SystemExit("빈 교훈")
    path = lessons_path(spec_path, node)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    name = os.path.splitext(os.path.basename(spec_path))[0]
    head = f"# {name}/{node} — 이 자리에서 배운 것\n\n" if not os.path.exists(path) else ""
    line = f"- {datetime.date.today():%Y-%m-%d}" + (f" / run {run}" if run else "") + f" / {one}\n"
    with open(path, "a", encoding="utf-8", newline="\n") as f:
        f.write(head + line)
    lines = [l for l in _rt(path, encoding="utf-8").splitlines(True) if l.startswith("- ")]
    return {"path": _rel(path), "lines": len(lines), "added": line.strip(),
            "hint": f'명세의 {node} 노드에 "lessons": "{os.path.relpath(path, set_project_from_spec(spec_path))}" 를 걸어야 워커가 받는다',
            "warn": "교훈이 12줄을 넘었다 — 묶거나 프롬프트로 올려라" if len(lines) > 12 else None}


def load_spec(path):
    set_project_from_spec(path)
    if os.environ.get("GE_REQUIRE_FABRIC") == "1":          # opt-in: refuse to run until <spec>/fabric.md has a choice
        fab = fabric.choice_problem(path)
        assert fab is None, fab
    spec = json.loads(_rt(path, encoding="utf-8"))
    ids = [n["id"] for n in spec["nodes"]]
    assert len(ids) == len(set(ids)), "노드 id 중복"
    for n in spec["nodes"]:
        for d in n.get("inputs", []):
            assert d in ids, f"{n['id']} 의 입력 {d} 가 없다"
        if n.get("args") is not None:
            assert n.get("kind") == "script", f"{n['id']}: args 는 script 노드에만"
            assert isinstance(n["args"], list) and all(isinstance(x, str) for x in n["args"]), f"{n['id']}: args 는 문자열 목록"
        if n.get("cwd"):
            # ${VAR}/%VAR% expand from the environment. Unset variables fail closed.
            _cwd = os.path.expandvars(n["cwd"])
            assert "${" not in _cwd and not re.search(r"%\w+%", _cwd), f"{n['id']}: cwd 환경변수 미설정: {n['cwd']}"
            n["cwd"] = os.path.abspath(proj_path(_cwd))
        if n.get("lessons"):
            assert n.get("kind") != "verify", f"{n['id']}: 검사자에게 교훈을 주지 마라 (작가와 같은 눈이 된다)"
            assert os.path.isfile(proj_path(n["lessons"])), f"{n['id']}: lessons 파일 없음 {n['lessons']}"
        if n.get("verify_thinking") is not None:
            assert n.get("kind") == "verify", f"{n['id']}: verify_thinking 은 verify 노드에만"
            assert n["verify_thinking"] in ("low", "medium", "high"), f"{n['id']}: verify_thinking 은 low|medium|high"
        if n.get("schema") is not None:
            bad = schema_problems(n["schema"])
            assert not bad, f"{n['id']}: schema — " + "; ".join(bad[:5])
        if n.get("apply"):
            # An apply node writes results. It must take a verify node as a direct input (checked again at run time).
            kinds = {m["id"]: m.get("kind", "model") for m in spec["nodes"]}
            assert n.get("kind") == "script", f"{n['id']}: apply 는 script 노드에만"
            assert any(kinds.get(d) == "verify" for d in n.get("inputs", [])), \
                f"{n['id']}: apply 노드는 verify 노드를 입력으로 받아야 한다"
        if n.get("stub_output"):
            assert os.path.isfile(proj_path(n["stub_output"])), f"{n['id']}: stub_output 파일 없음 {n['stub_output']}"
    spec["_path"] = os.path.abspath(path)
    # The contract (inputs, scope, runtime checks) is validated before the run starts. It is part of _sha:
    # a changed contract is a different run.
    spec["_contract"] = guard.validate_contract(spec, PROJ)
    spec["_sha"] = sha256_text(json.dumps([spec["nodes"], spec.get("contract")], sort_keys=True, ensure_ascii=False))[:12]
    return spec


def contract_sha(spec_path, write=False):
    """contract.inputs 마다 guard 와 같은 방식(CRLF→LF 정규화)으로 sha256 을 구한다. write 면 명세 파일의 sha256 을 갱신.
    파일은 다시 직렬화한다(들여쓰기는 원본 감지). 읽지 못한 입력이 있으면 ok=False, 쓰지 않는다."""
    set_project_from_spec(spec_path)
    text = _rt(spec_path, encoding="utf-8", newline="")
    spec = json.loads(text)
    rows, ok = [], True
    for it in (spec.get("contract") or {}).get("inputs", []):
        try:
            data = _rb(guard._abs(PROJ, it["path"]))
        except OSError as e:
            rows.append({"id": it["id"], "path": it["path"], "error": str(e.strerror or e)}); ok = False; continue
        new = guard.sha256_bytes(data)
        rows.append({"id": it["id"], "path": it["path"], "old": it.get("sha256"), "new": new, "changed": it.get("sha256") != new})
        it["sha256"] = new
    if write and ok and any(r["changed"] for r in rows):
        m = re.search(r"^( +)\"", text, re.M)
        eol = "\r\n" if "\r\n" in text else "\n"
        out = json.dumps(spec, ensure_ascii=False, indent=len(m.group(1)) if m else 1)
        with open(spec_path, "w", encoding="utf-8", newline="") as f:
            f.write(out.replace("\n", eol))
    return {"ok": ok, "written": bool(write and ok and any(r["changed"] for r in rows)), "inputs": rows}


PATH_WARN_LEN = 200   # Windows MAX_PATH 260 에서 산출물 하위 경로 여유를 뺀 값


def path_length_warnings(spec, run_id):
    """런 폴더 + 가장 깊은 하위 경로가 Windows 한도(260)에 닿을지 plan 단계에서 경고한다."""
    base = os.path.join(GE_DIR, "runs", run_id, "artifacts")
    out = []
    if sys.platform == "win32" and len(base) > PATH_WARN_LEN - 60:
        out.append(f"런 폴더가 길다({len(base)}자): run-id 를 줄여라 → {base[:60]}…")
    for n in spec["nodes"]:
        p = os.path.join(base, n["id"] + "-a1-" + "x" * 40 + ".json")
        if sys.platform == "win32" and len(p) > PATH_WARN_LEN:
            out.append(f"노드 {n['id']}: 산출 경로 ~{len(p)}자 (한도 260). run-id·노드 id 를 줄여라")
    return out


def topo(spec):
    """Topological order. Nodes that become ready together keep the order they are declared in the spec
    (sorting by name silently dropped the author's order)."""
    done, order = set(), []
    nodes = {n["id"]: n for n in spec["nodes"]}
    decl = {n["id"]: i for i, n in enumerate(spec["nodes"])}
    while len(order) < len(nodes):
        ready = [i for i, n in nodes.items() if i not in done and all(d in done for d in n.get("inputs", []))]
        if not ready:
            raise SystemExit("순환 의존")
        order += sorted(ready, key=lambda i: decl[i])
        done |= set(ready)
    return order


def read_rel(p):
    return _rt(proj_path(p), encoding="utf-8")


LESSON_HEADER = ("\n\n## 이 자리에서 이미 배운 것 (같은 실수를 두 번 하지 마라)\n"
                "아래는 이 노드가 전에 실제로 틀렸던 것이다. 지시와 충돌하면 지시가 이긴다.\n\n")


RETRY_FEEDBACK_MAX = 8


def feedback_count(errs):
    """retry_feedback 이 실제로 프롬프트에 붙일 오류 건수(상한 RETRY_FEEDBACK_MAX 이전의 전체 건수)."""
    return len([e for e in (errs or []) if e and e != "never"])


def retry_feedback(prompt, errs):
    """재시도 프롬프트에 직전 시도의 실패 이유를 붙인다. 첫 시도(errs=None)는 그대로.

    Retrying the same prompt repeats the same mistake. The validation and anchor errors are attached
    as plain strings so the next attempt knows where it failed.
    """
    errs = [str(e) for e in (errs or []) if e and e != "never"]
    if not errs:
        return prompt
    lines = "\n".join("- " + " ".join(e.split())[:400] for e in errs[:RETRY_FEEDBACK_MAX])
    more = f"\n- (그 밖 {len(errs) - RETRY_FEEDBACK_MAX}건)" if len(errs) > RETRY_FEEDBACK_MAX else ""
    return (prompt + "\n\n## 직전 시도가 실패한 이유 (코디가 검사한 결과)\n" + lines + more +
            "\n위 이유를 고쳐 같은 형식으로 다시 답하라. 통과한 부분은 바꾸지 마라.\n")


def render(node, produced, item=None, inputs_kv=None, contract=None):
    txt = read_rel(node["prompt"]) if node.get("prompt") else ""
    if node.get("rubric"):
        txt = txt.replace("{{rubric}}", guard.strip_mechanical(read_rel(node["rubric"]), contract))   # mechanical items are filled by the probe
    # Lessons go to producing nodes only. A checker that gets them sees with the author's eyes
    # (same reason only the checker reads the rubric). load_spec refuses verify+lessons.
    if node.get("lessons") and node.get("kind") != "verify":
        txt += LESSON_HEADER + read_rel(node["lessons"]).strip() + "\n"
    # Contract inputs go to every node (checker included) as the same text. Facts are not rubric.
    # When the coordinator attaches them, a worker cannot "fail to read" them.
    if contract:
        txt += guard.render_inputs(contract, PROJ)
    for dep in node.get("inputs", []):
        txt = txt.replace("{{input." + dep + "}}", json.dumps(produced.get(dep), ensure_ascii=False, indent=1))
    for k, v in (inputs_kv or {}).items():
        txt = txt.replace("{{" + k + "}}", v)
    if item is not None:
        if isinstance(item, dict):
            for k, v in item.items():
                txt = txt.replace("{{item." + k + "}}", v if isinstance(v, str) else json.dumps(v, ensure_ascii=False))
        txt = txt.replace("{{item}}", json.dumps(item, ensure_ascii=False))
    return txt + f"\n\n[node:{node['id']}]"


