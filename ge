def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def sha256_text(s):
    return hashlib.sha256(s.encode("utf-8")).hexdigest()


def _rt(path, encoding="utf-8", errors=None, newline=None):
    """Read a text file and close it."""
    with open(path, encoding=encoding, errors=errors, newline=newline) as f:
        return f.read()


def _rb(path):
    with open(path, "rb") as f:
        return f.read()


def ge_sha():
    """Commit of this ge checkout (recorded in run_started so runs can be compared across versions)."""
    try:
        r = subprocess.run(["git", "rev-parse", "HEAD"], cwd=GE_HOME, capture_output=True, text=True, timeout=10)
    except Exception:
        return None
    out = r.stdout.strip()
    return out if r.returncode == 0 and re.fullmatch(r"[0-9a-f]{7,40}", out) else None


def claude_bin():
    """claude executable. GE_CLAUDE > PATH (on Windows which() also finds claude.cmd/.exe) > None."""
    return os.environ.get("GE_CLAUDE") or shutil.which("claude")


def grok_bin():
    """grok 실행 파일. GE_GROK > PATH > None. .py 는 테스트용 fake."""
    return os.environ.get("GE_GROK") or shutil.which("grok")


def grok_cmd():
    exe = grok_bin()
    if not exe:
        return None
    if exe.lower().endswith(".py"):
        return [sys.executable, exe]
    return [exe]


def cursor_cmd():
    """Cursor Agent CLI. GE_CURSOR (.py = test fake, .js = run with node) > %LOCALAPPDATA%/cursor-agent/versions/<latest>/index.js
    (Windows: calling index.js directly avoids the .cmd wrapper's quoting) > cursor-agent on PATH."""
    exe = os.environ.get("GE_CURSOR")
    if exe:
        if exe.lower().endswith(".py"):
            return [sys.executable, exe]
        if exe.lower().endswith(".js"):
            node = os.path.join(os.path.dirname(exe), "node.exe")
            return [node if os.path.exists(node) else "node", exe]
        return [exe]
    root = os.path.join(os.environ.get("LOCALAPPDATA", ""), "cursor-agent", "versions")
    if os.path.isdir(root):
        vers = sorted(d for d in os.listdir(root) if os.path.isfile(os.path.join(root, d, "index.js")))
        if vers:
            d = os.path.join(root, vers[-1])
            node = os.path.join(d, "node.exe")
            return [node if os.path.exists(node) else "node", os.path.join(d, "index.js")]
    exe = shutil.which("cursor-agent")
    return [exe] if exe else None


def _node_for_script(script):
    """Return a node executable for a JS CLI script, preferring the npm-adjacent node.exe on Windows."""
    local = os.path.join(os.path.dirname(script), "node.exe")
    return local if os.path.exists(local) else (shutil.which("node") or "node")


def _npm_codex_js_from_cmd(cmd_path):
    """Resolve npm codex.cmd next to node_modules/@openai/codex/bin/codex.js.
    Avoids cmd.exe argument quoting issues. For arbitrary GE_CODEX .cmd files, keep the override literal."""
    base = os.path.dirname(cmd_path)
    js = os.path.join(base, "node_modules", "@openai", "codex", "bin", "codex.js")
    return js if os.path.isfile(js) else None


def codex_cmd():
    """Codex CLI.
    GE_CODEX(.py fake, .js, or explicit executable) overrides discovery. PATH npm codex.cmd is resolved
    to node + node_modules/@openai/codex/bin/codex.js when possible to avoid cmd.exe quoting.
    Arbitrary .cmd overrides are honored as explicit user input but may depend on Windows wrapper quoting."""
    override = os.environ.get("GE_CODEX")
    exe = override or shutil.which("codex")
    if not exe:
        return None
    low = exe.lower()
    if low.endswith(".py"):
        return [sys.executable, exe]
    if low.endswith(".js"):
        return [_node_for_script(exe), exe]
    if low.endswith((".cmd", ".bat")) and not override:
        js = _npm_codex_js_from_cmd(exe)
        if js:
            return [_node_for_script(js), js]
    return [exe]


